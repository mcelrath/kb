{
  "description": "kb plugin hooks — findings surfacing, kb conventions injection, and kb-add enforcement",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/setup-venv.sh\"",
            "timeout": 300
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/env-probe.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
