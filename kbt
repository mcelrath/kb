#!/usr/bin/env python3
"""
kbt — kb-native issue tracker with transition passthrough.

Backend resolution (highest priority first; see kb/issue_cli.py::resolve_backend):
1. KBT_BACKEND env var (test/override; logged to stderr when it fires)
2. per-project .kbt/config.toml [tracker] backend (walk UP from cwd)
3. legacy .beads/config.yaml `backend:` (walk UP; deprecation warning)
4. host-wide ~/.config/kb/config.toml [tracker] backend
5. default: 'dolt' if `bd` on PATH else 'kb' (TRANSITIONAL — emits a migration
   notice; flips to unconditional 'kb' at cutover kb-sg0.8 when bd is removed).

`kbt bead-migrate` writes the per-project .kbt marker (step 2) and removes
.beads/, moving a project off dolt for good.

When backend == 'dolt':  os.execvp('bd', ['bd'] + sys.argv[1:])
  exec-replace gives byte-identical stdin/stdout/stderr/exit-code/signals.
  subprocess.run would silently break heredoc callers and $? checks.
  EXCEPTION: `bead-migrate` and `import` always run on kb (bypass passthrough).

When backend == 'kb':  dispatch to kb/issue_cli.py
"""

import os
import sys
from pathlib import Path

# Ensure the project's kb package is importable when invoked directly
_here = Path(__file__).resolve().parent
if str(_here) not in sys.path:
    sys.path.insert(0, str(_here))


def main() -> None:
    from kb.issue_cli import resolve_backend, run, build_parser

    # Top-level help/usage always shows kbt's OWN interface, even on a bd
    # passthrough host — otherwise `kbt` / `kbt --help` execs `bd --help` and
    # advertises bd-only commands (gate, merge-slot, wisp, ...) the kb backend
    # does not implement. (The kbt contract is the same regardless of backend.)
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        build_parser().print_help()
        sys.exit(0)

    # ALWAYS-KB commands: these operate ON the kb-native backend regardless of the
    # resolved backend — `bead-migrate` migrates FROM dolt TO kb (passing it through
    # to bd would be nonsensical), and `import` writes kb rows. Bypass resolution.
    if argv[0] in ("bead-migrate", "import"):
        sys.exit(run(sys.argv[1:]))

    backend = resolve_backend(Path.cwd())

    if backend == "dolt":
        # TRANSITION PASSTHROUGH: exec-replace with the real bd binary.
        # os.execvp replaces this process entirely — no return, no subprocess
        # overhead, byte-identical stdin/stdout/stderr/exit/signals.
        # sys.argv[0] is 'kbt'; pass 'bd' as argv[0] to bd so bd sees its own name.
        # execvp does NOT return on success; on ENOENT it RAISES OSError (it does
        # not fall through), so catch it to emit a clean message, not a traceback.
        try:
            os.execvp("bd", ["bd"] + sys.argv[1:])
        except OSError:
            print("kbt: exec bd failed — is bd installed? "
                  "(set KBT_BACKEND=kb to use the kb-native backend)", file=sys.stderr)
            sys.exit(127)

    # backend == 'kb'
    sys.exit(run(sys.argv[1:]))


if __name__ == "__main__":
    main()
