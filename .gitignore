__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.eggs/
dist/
build/
*.so
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Dolt database files (added by bd init)
.dolt/
# SQLite DBs + WAL/SHM are data/scratch — never track (incl. the test/smoke
# artifacts that pile up under tmp/<topic>/). Scratch SCRIPTS in tmp/ stay tracked.
*.db
*.db-wal
*.db-shm
# scratch test fixtures (PDFs etc.) under tmp/
tmp/**/*.pdf

# Planning docs are local working state — never tracked (purged from history 2026-06-16).
.claude/plans/
