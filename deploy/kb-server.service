[Unit]
Description=kb HTTP/SSE server (bridge transport + kb/issues read endpoints)
Documentation=https://github.com/mcelrath/kb
After=network.target

[Service]
Type=simple
# Run from source via the repo venv (Python 3.14). --host 0.0.0.0 (NOT 127.0.0.1):
# the kb SSE bridge watcher is launched via the Bash tool's run_in_background, so it
# runs in the command SANDBOX, whose namespaced loopback can't reach the host's
# 127.0.0.1. Binding 0.0.0.0 lets it answer on the host interface (e.g. ash:8765,
# sandbox-allowlisted) while harness-side hooks keep using 127.0.0.1. (kb-2os.3)
ExecStart=/home/mcelrath/Projects/ai/kb/.venv/bin/python /home/mcelrath/Projects/ai/kb/kb.py serve --port 8765 --host 0.0.0.0
# Clean env: NO KB_EMBEDDING_URL override here, so kb falls back to its default
# (ash:8081, the healthy qwen3/4096 server). The bridge endpoints don't need
# embeddings at all; only /kb/search does, and that degrades to FTS if down.
# Once the kb config-file lands (~/.config/kb/config.toml) the server reads that.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
